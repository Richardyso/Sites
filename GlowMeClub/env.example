# ===== CONFIGURAÇÕES DO GLOWMECLUB =====

# Ambiente (development, production)
NODE_ENV=production

# ===== CREDENCIAIS FIREBASE =====
# Obtenha essas credenciais no Console do Firebase:
# 1. Acesse console.firebase.google.com
# 2. Selecione seu projeto
# 3. Vá em Configurações do Projeto > Contas de serviço
# 4. Clique em "Gerar nova chave privada"
# 5. Use os valores do JSON baixado

FIREBASE_PROJECT_ID=seu-projeto-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@seu-projeto-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nSUA_CHAVE_PRIVADA_AQUI\n-----END PRIVATE KEY-----\n"

# ===== CONFIGURAÇÕES DE EMAIL (OPCIONAL) =====
# Para envio de emails de boas-vindas, recuperação de senha, etc.

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=seu-email@gmail.com
EMAIL_PASS=sua-senha-de-app

# ===== URL DO FRONTEND =====
FRONTEND_URL=https://glowmeclub.vercel.app
