{
  "version": 2,
  "rewrites": [
    {
      "source": "/((?!api/|assets/|pages/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/translations.js": { "includeFiles": "assets/traducoes/*.sqlite" },
    "api/verses.js": { "includeFiles": "assets/**" },
    "api/search.js": { "includeFiles": "assets/**" }
  }
}
