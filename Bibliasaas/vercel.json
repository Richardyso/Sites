{
  "version": 2,
  "rewrites": [
    { "source": "/((?!api/|assets/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/translations.js": {
      "includeFiles": "assets/traducoes/*.sqlite"
    },
    "api/verses.js": {
      "includeFiles": [
        "assets/traducoes/*.sqlite",
        "node_modules/sql.js/dist/sql-wasm.wasm"
      ]
    }
  }
}
